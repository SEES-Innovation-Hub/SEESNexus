# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Database ---
# Local dev with Docker Compose (see docker-compose.yml). Render-style
# "postgres://..." URLs are accepted too and switched to the async driver.
DATABASE_URL=postgresql+asyncpg://sees_nexus:sees_nexus@localhost:5432/sees_nexus
# Local dev without Docker (SQLite fallback, no setup required):
# DATABASE_URL=sqlite+aiosqlite:///./sees_nexus.db

# --- Auth / JWT ---
# Required with Postgres: the app refuses to start with this placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-32-plus-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudinary (image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (OTP / transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@seesnexus.example
BREVO_SENDER_NAME=SEES Nexus

# --- Admin sign-up ---
# Anyone who registers with this key gets an ADMIN account, so share it only
# with people who should be admins. At least 24 characters. Leave empty to
# switch admin sign-up off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_REGISTRATION_KEY=

# --- Client IP behind a proxy ---
# Rate limits are per client IP. Set to 1 on Render (its load balancer adds
# the client's address to X-Forwarded-For). 0 = use the direct connection's
# address, right for local development. Never set it higher than the number
# of proxies really in front of the app.
TRUSTED_PROXY_COUNT=0

# --- CORS ---
# Comma-separated list. Never use "*" (Tech Doc §9.1).
CORS_ORIGINS=http://localhost:5173

# --- OTP behavior ---
OTP_EXPIRE_MINUTES=10
# Returns the OTP in the /notify/send-code response so local development works
# without an email provider. Ignored whenever BREVO_API_KEY is set, so a
# deployment that can send email never leaks the code regardless of this value.
OTP_DEBUG_RETURN_CODE=true
