# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Database ---
# Local dev with Docker Compose (see docker-compose.yml):
DATABASE_URL=postgresql+asyncpg://sees_nexus:sees_nexus@localhost:5432/sees_nexus
# Local dev without Docker (SQLite fallback, no setup required):
# DATABASE_URL=sqlite+aiosqlite:///./sees_nexus.db

# --- Auth / JWT ---
SECRET_KEY=change-me-to-a-random-32-plus-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudinary (image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (OTP / transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@seesnexus.example
BREVO_SENDER_NAME=SEES Nexus

# --- CORS ---
# Comma-separated list. Never use "*" (Tech Doc §9.1).
CORS_ORIGINS=http://localhost:5173

# --- OTP behavior ---
OTP_EXPIRE_MINUTES=10
# Set to false in staging/production once Brevo is wired up.
OTP_DEBUG_RETURN_CODE=true
